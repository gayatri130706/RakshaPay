# RakshaPay Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL - if not set, falls back to SQLite
DATABASE_URL=postgresql://postgres:password@localhost:5432/rakshapay

# JWT Secret Key - CHANGE THIS in production
SECRET_KEY=rakshapay-super-secret-key-change-this-in-production-2024

# Gemini API Key - get free at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# Token expiry in hours
ACCESS_TOKEN_EXPIRE_HOURS=24
